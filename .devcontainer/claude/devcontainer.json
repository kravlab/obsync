// Devcontainer for running Claude Code on the project, wired to hostrunner
// so the container can run the host commands allowed in
// .devcontainer/hostrun.yaml. Requires mise in the host's PATH, hostrunner
// in the project's mise config (docs/specs/devcontainer-hostrunner-mise.md)
// and a regular clone (.git a directory).
// The host's git identity, its global git excludes, its global Claude Code
// skills, hooks and plugins and, optionally, the global instructions named
// by $HOSTRUNNER_AGENTS_MD reach the container read-only
// (docs/specs/devcontainer-host-config.md,
// docs/specs/devcontainer-git-excludes.md,
// docs/specs/devcontainer-claude-skills-hooks.md,
// docs/specs/devcontainer-claude-plugins.md).
//
// From the devcontainer template (github.com/kravlad/devcontainer-template),
// which owns this file: `mise run dc-template-update` updates it and merges
// local edits.
// The specs named here are in its docs/specs/.
{
  // The project's name is its folder's, here and in the names below.
  "name": "${localWorkspaceFolderBasename} (Claude Code)",
  "build": { "dockerfile": "../Dockerfile", "context": "..", "target": "claude" },

  // A recognizable container name and shell prompt host name. Names are
  // unique per host: of two projects in folders of the same name only one
  // can have its container, running or stopped.
  "runArgs": [
    "--name", "${localWorkspaceFolderBasename}-agent",
    "--hostname", "${localWorkspaceFolderBasename}-agent"
  ],

  // The agent's part of the toolchain in mise.toml (mise is in the image):
  // the project's setup-agent task, or the template's default,
  // `mise install` (.config/mise/conf.d/devcontainer.toml).
  // Before it, an install outside the project (-C /), where mise reads
  // only the image's config, which names Claude Code: it creates the
  // shim of the one in the tool store, whatever the project's task does,
  // and where the store has none installs the newest release at least
  // five days old in the container
  // (docs/specs/devcontainer-shared-store.md).
  "postCreateCommand": "MISE_MINIMUM_RELEASE_AGE=5d mise -C / install && mise trust && mise run setup-agent",

  // mise reads the tools of the store mounted below, which the host's
  // projects share, and installs what the store lacks in the container:
  // the agent cannot write to the store.
  "containerEnv": {
    "MISE_SHARED_INSTALL_DIRS": "/home/vscode/.local/share/mise-store/installs"
  },

  // All run on the host, in parallel; any failing fails `devcontainer up`.
  // A script is given to /bin/sh, the shell its first line names: named
  // as the program it would need its executable bit, which a project's
  // copy of the file can lose.
  "initializeCommand": {
    // Starts the host daemon for this container, or re-arms the running one,
    // and installs the hostrun client into the runtime directory mounted below.
    // The rules are the default .devcontainer/hostrun.yaml.
    // mise runs the hostrunner the project's mise config names, a tool of
    // the project's like its others, so the host needs none in its PATH
    // and the version is the project's. mise installs it where the host
    // lacks it, with every other tool of the project the host lacks.
    // -C: mise finds that config from the project's root, whatever
    // directory this command runs in. No tool is named: for one named
    // without a version mise looks for the latest release, not the
    // project's.
    "hostrunner": [
      "mise", "-C", "${localWorkspaceFolder}", "exec", "--",
      "hostrunner", "up",
      "--dir", "${localEnv:XDG_RUNTIME_DIR}/hostrunner/${devcontainerId}",
      "--workspace", "${localWorkspaceFolder}",
      "--container-workspace", "${containerWorkspaceFolder}"
    ],
    // Copies user.name and user.email from the host's global git config
    // into the directory mounted at /run/host-config (see the script).
    "git-identity": [
      "/bin/sh", "${localWorkspaceFolder}/.devcontainer/git-identity.sh",
      "${localEnv:XDG_RUNTIME_DIR}/hostrunner-host-config/${devcontainerId}"
    ],
    // Copies the host's global git excludes file there too; the image links
    // ~/.config/git/ignore to it (docs/specs/devcontainer-git-excludes.md).
    "git-excludes": [
      "/bin/sh", "${localWorkspaceFolder}/.devcontainer/git-excludes.sh",
      "${localEnv:XDG_RUNTIME_DIR}/hostrunner-host-config/${devcontainerId}"
    ],
    // Links the CLAUDE.md mount source below to $HOSTRUNNER_AGENTS_MD, or
    // to an empty file when it is not set (see the script).
    "agents-md": [
      "/bin/sh", "${localWorkspaceFolder}/.devcontainer/claude/agents-md.sh",
      "${localEnv:XDG_RUNTIME_DIR}/hostrunner-host-config/${devcontainerId}",
      "${localEnv:HOSTRUNNER_AGENTS_MD}"
    ],
    // Copies the host's global skills (~/.claude/skills) into claude/skills
    // there; the image links /etc/claude-code/.claude/skills to it
    // (docs/specs/devcontainer-claude-skills-hooks.md).
    "skills": [
      "/bin/sh", "${localWorkspaceFolder}/.devcontainer/claude/skills.sh",
      "${localEnv:XDG_RUNTIME_DIR}/hostrunner-host-config/${devcontainerId}"
    ],
    // Copies the host's plugins (the marketplaces and cached files of
    // ~/.claude/plugins) into claude/plugins there, the seed directory the
    // image names in CLAUDE_CODE_PLUGIN_SEED_DIR
    // (docs/specs/devcontainer-claude-plugins.md).
    "plugins": [
      "/bin/sh", "${localWorkspaceFolder}/.devcontainer/claude/plugins.sh",
      "${localEnv:XDG_RUNTIME_DIR}/hostrunner-host-config/${devcontainerId}"
    ],
    // Copies the host's global hooks and the plugins it enables (the hooks
    // key of ~/.claude/settings.json and the true entries of its
    // enabledPlugins) into claude/host-settings.json there; the image
    // links a /etc/claude-code/managed-settings.d file to it.
    "settings": [
      "/bin/sh", "${localWorkspaceFolder}/.devcontainer/claude/settings.sh",
      "${localEnv:XDG_RUNTIME_DIR}/hostrunner-host-config/${devcontainerId}"
    ]
  },

  "mounts": [
    // The daemon's socket and the hostrun client (read-only).
    "source=${localEnv:XDG_RUNTIME_DIR}/hostrunner/${devcontainerId},target=/run/hostrunner,type=bind,readonly",
    // .devcontainer (with the rules and this file) stays read-only inside the container.
    "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,readonly",
    // The repository's git config and hooks, which host git reads on
    // `hostrun git`, cannot be edited in place. Not a guarantee: see
    // hostrunner's README (.git/commondir, renaming .git, nested
    // repositories). The config is a single-file mount, so the container
    // sees host-side config changes only after a restart.
    "source=${localWorkspaceFolder}/.git/config,target=${containerWorkspaceFolder}/.git/config,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/hooks,target=${containerWorkspaceFolder}/.git/hooks,type=bind,readonly",
    // Bash history and Claude Code's login and settings survive rebuilds
    // (see the Dockerfile).
    "source=${localWorkspaceFolderBasename}-bashhistory-${devcontainerId},target=/home/vscode/.commandhistory,type=volume",
    "source=${localWorkspaceFolderBasename}-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    // The host's tool store, which the everyday containers fill and
    // `mise run agent-update` puts Claude Code in: read-only, so the agent
    // cannot change what every project runs.
    "source=devcontainer-mise-store,target=/home/vscode/.local/share/mise-store,type=volume,readonly",
    // The package cache is the container's own and survives rebuilds: the
    // one the everyday containers share is not mounted, so the agent
    // neither reads other projects' packages nor writes to it.
    "source=${localWorkspaceFolderBasename}-cache-${devcontainerId},target=/home/vscode/.cache,type=volume",
    // The host's git identity, included from the image's system git config,
    // its global excludes, linked from ~/.config/git/ignore, and its global
    // skills, hooks and plugins (claude/): the first two linked from
    // /etc/claude-code, the plugins named in CLAUDE_CODE_PLUGIN_SEED_DIR.
    // A directory: the scripts replace the files, and a single-file mount
    // would keep showing the old ones.
    "source=${localEnv:XDG_RUNTIME_DIR}/hostrunner-host-config/${devcontainerId},target=/run/host-config,type=bind,readonly",
    // The copied skills, hooks and plugins again, at the path the host's
    // ~/.claude has on the host: a host hook that reads a skill through its
    // absolute host path runs unchanged in the container.
    "source=${localEnv:XDG_RUNTIME_DIR}/hostrunner-host-config/${devcontainerId}/claude,target=${localEnv:HOME}/.claude,type=bind,readonly",
    // The host user's global instructions, read-only so the agent cannot
    // rewrite them. The source is agents-md.sh's symlink, which the engine
    // resolves when the container starts: the original file itself is
    // mounted, so in-place edits on the host show up at once; a save that
    // renames a new file over it keeps the old content until a restart.
    "source=${localEnv:XDG_RUNTIME_DIR}/hostrunner-host-config/${devcontainerId}/CLAUDE.md,target=/home/vscode/.claude/CLAUDE.md,type=bind,readonly"
  ],

  // /run/hostrunner for `hostrun`; the rest of PATH comes from the image.
  // First: the client there is the one the host's daemon installed, of
  // the daemon's version. After the image's PATH, mise's shims would
  // answer `hostrun` with the copy mise installs in the container, where
  // hostrunner is a tool of the project too.
  "remoteEnv": { "PATH": "/run/hostrunner:${containerEnv:PATH}" }
}
