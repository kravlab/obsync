{
	"name": "seamsync",
	"version": "0.2.0",
	"description": "Sync a vault across devices through a cloud storage service.",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@12.13.0",
	"scripts": {
		"build": "tsc --noEmit && node scripts/esbuild.config.mjs production",
		"dev": "node scripts/esbuild.config.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint --config scripts/eslint.config.mjs . --max-warnings 0",
		"test": "vitest run --config test/vitest.config.mjs",
		"test:e2e:desktop": "pnpm build && vitest run --config test/e2e/vitest.desktop.config.mjs",
		"test:e2e:android": "pnpm build && vitest run --config test/e2e/vitest.android.config.mjs",
		"test:e2e:pair": "pnpm build && vitest run --config test/e2e/vitest.pair.config.mjs"
	},
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "9.39.5",
		"@eslint/json": "0.14.0",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"fake-indexeddb": "6.2.6",
		"jsdom": "30.1.3",
		"obsidian": "1.14.4",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vitest": "5.0.4"
	},
	"dependencies": {
		"ignore": "7.0.12",
		"node-diff3": "3.2.1"
	}
}
